{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermeticum-bce.eu/schemas/hbce-subject-verification-request.schema.json",
  "title": "HBCE Bank Subject Verification Request",
  "description": "Delimited Subject claim verification request corresponding to POST /subjects/verify in HBCE Bank API v0.1-R1.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_ref",
    "claims_requested",
    "purpose",
    "context_ref"
  ],
  "properties": {
    "subject_ref": {
      "type": "string",
      "pattern": "^SUB-[A-Z0-9][A-Z0-9._:-]{2,127}$"
    },
    "claims_requested": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "context_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
