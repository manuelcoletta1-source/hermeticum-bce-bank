{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermeticum-bce.eu/schemas/hbce-authorization.schema.json",
  "title": "HBCE Bank Authorization",
  "description": "Canonical Bank Edition authorization representation. An authorization is a bounded positive grant for a specific action. A denied request does not create an authorization. Authorization does not prove execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "status",
    "mandate_reference",
    "authority_reference",
    "decision_reference",
    "authorized_subject",
    "request",
    "runtime_binding",
    "validity",
    "usage",
    "issued_at",
    "issued_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^AUTHORIZATION-[A-Z0-9][A-Z0-9._:-]{2,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ISSUED",
        "CONSUMED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "mandate_reference": {
      "$ref": "#/$defs/reference"
    },
    "authority_reference": {
      "$ref": "#/$defs/reference"
    },
    "decision_reference": {
      "$ref": "#/$defs/reference"
    },
    "authorized_subject": {
      "$ref": "#/$defs/actor_reference"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "runtime_binding": {
      "$ref": "#/$defs/runtime_binding"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "policy_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "evidence_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "$ref": "#/$defs/actor_reference"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_type"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_type": {
          "type": "string",
          "enum": [
            "HUMAN",
            "ORGANIZATION",
            "AI",
            "AGENT",
            "MACHINE",
            "SYSTEM"
          ]
        },
        "ipr_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "domain",
        "action"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "domain": {
          "type": "string",
          "enum": [
            "PAYMENT",
            "CREDIT",
            "ACCOUNT",
            "KYC_AML",
            "TREASURY",
            "AUDIT",
            "GENERAL_BANKING"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_reference": {
          "$ref": "#/$defs/reference"
        },
        "account_reference": {
          "$ref": "#/$defs/reference"
        },
        "beneficiary_reference": {
          "$ref": "#/$defs/reference"
        },
        "amount": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "runtime_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "runtime_type"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtime_type": {
          "type": "string",
          "enum": [
            "AI_AGENT",
            "AI_MODEL",
            "DETERMINISTIC_SOFTWARE",
            "MACHINE",
            "HUMAN_OPERATED_SOFTWARE",
            "EXTERNAL_SERVICE"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_digest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "clock_skew_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300,
          "default": 0
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_uses"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "SINGLE_USE",
            "MULTI_USE"
          ]
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1
        },
        "consumption_reference": {
          "$ref": "#/$defs/reference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "SINGLE_USE"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "max_uses": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "created_by"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "$ref": "#/$defs/reference"
        },
        "authorization_event_reference": {
          "$ref": "#/$defs/reference"
        },
        "previous_authorization_reference": {
          "$ref": "#/$defs/reference"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CONSUMED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "usage": {
            "required": [
              "consumption_reference"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {
            "required": [
              "consumption_reference"
            ]
          }
        },
        "required": [
          "usage"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "CONSUMED"
          }
        }
      }
    }
  ]
}
